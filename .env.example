# YouTube membership verification (Google OAuth)
# Leave GOOGLE_OAUTH_* empty to disable the whole feature.
# 1. Google Cloud: create a project, enable "YouTube Data API v3", create an
#    OAuth 2.0 "Web application" client, and add your callback as an authorized
#    redirect URI (must be HTTPS, e.g. https://bot.example.com/oauth/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your.domain/oauth/callback
# Least-privilege scope. If members-only comment reads return 403 for real
# members, switch to https://www.googleapis.com/auth/youtube.force-ssl
MEMBERSHIP_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly
# Where the callback web server listens inside the container. Reverse-proxy
# GOOGLE_OAUTH_REDIRECT_URI (HTTPS) to this port.
MEMBERSHIP_OAUTH_HOST=0.0.0.0
MEMBERSHIP_OAUTH_PORT=8081
# Host port docker-compose publishes for the callback server.
MEMBERSHIP_OAUTH_EXPOSED_PORT=8081
# Discord guild the roles live in.
MEMBERSHIP_GUILD_ID=
# Multiple channels -> roles in that guild (CSV of UC<channel>:<discord_role_id>).
# A user authorizes ONCE and gets every role they qualify for. Example:
#   MEMBERSHIP_CHANNELS=UCaaaaaaaaaaaaaaaaaaaaaa:111111111111111111,UCbbbbbbbbbbbbbbbbbbbbbb:222222222222222222
MEMBERSHIP_CHANNELS=
# Single-channel shortcut (used only when MEMBERSHIP_CHANNELS is empty).
MEMBERSHIP_ROLE_ID=
MEMBERSHIP_YT_CHANNEL_ID=
# Optional: force specific members-only probe video ids (CSV). Only used when a
# SINGLE channel is configured; otherwise probe videos are auto-discovered from
# each channel's members-only uploads playlist (UC... -> UUMO...).
MEMBERSHIP_PROBE_VIDEO_IDS=
# Recommended: a YouTube Data API key so the members-only playlist can be listed
# without relying on a member's token.
YOUTUBE_API_KEY=
# Required. Encrypts stored refresh tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMBERSHIP_TOKEN_ENC_KEY=
# Re-verify every linked member this often (seconds). Mind the API quota:
# 1 unit/check, 10k/day default, shared across all users.
MEMBERSHIP_CHECK_INTERVAL=21600
# Optional: redirect the browser here after the callback instead of showing a page.
MEMBERSHIP_SUCCESS_REDIRECT=