# YouTube membership verification (Google OAuth)
# Leave GOOGLE_OAUTH_* empty to disable the whole feature.
# 1. Google Cloud: create a project, enable "YouTube Data API v3", create an
#    OAuth 2.0 "Web application" client, and add your callback as an authorized
#    redirect URI (must be HTTPS, e.g. https://bot.example.com/oauth/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your.domain/oauth/callback
# Required scope. force-ssl is needed to read members-only comment threads;
# youtube.readonly returns 403 insufficientPermissions and can't verify.
MEMBERSHIP_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl
# Where the callback web server listens inside the container. Reverse-proxy
# GOOGLE_OAUTH_REDIRECT_URI (HTTPS) to this port.
MEMBERSHIP_OAUTH_HOST=0.0.0.0
MEMBERSHIP_OAUTH_PORT=8081
# Host port docker-compose publishes for the callback server.
MEMBERSHIP_OAUTH_EXPOSED_PORT=8081
# Optional. The bot serves every guild it's in; each server's admins map
# channels->roles there with /membership_add (stored per guild in the DB).
# This is only used to backfill the guild when upgrading from an older
# single-guild install; new setups can leave it blank.
MEMBERSHIP_GUILD_ID=
# Channel -> role mappings are NOT set here. Admins create them at runtime with
# /membership_add <channel_id> <role> (and /membership_remove, /membership_list).
# Members-only probe videos are auto-discovered from each channel's members-only
# uploads playlist (UC... -> UUMO...).
# Recommended: a YouTube Data API key so that playlist can be listed reliably
# without depending on a member's token.
YOUTUBE_API_KEY=
# Required. Encrypts stored refresh tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEMBERSHIP_TOKEN_ENC_KEY=
# Re-verify every linked member this often (seconds). Mind the API quota:
# 1 unit/check, 10k/day default, shared across all users.
MEMBERSHIP_CHECK_INTERVAL=21600
# Optional: redirect the browser here after the callback instead of showing a page.
MEMBERSHIP_SUCCESS_REDIRECT=

# YouTube live-stream recording (admin /record_start /record_stop /record_list
# /record_files /record_share /record_upload). Requires yt-dlp (requirements.txt)
# and ffmpeg (installed in the image).
# In-container path recordings are written to. Keep it aligned with the compose
# recordings mount target (/app/recordings).
RECORDING_OUTPUT_DIR=recordings
# Host directory bound to the container's recordings folder (see docker-compose).
# Point this at a larger disk if you record a lot.
RECORDING_HOST_DIR=./recordings
# Max simultaneous recordings.
RECORDING_MAX_CONCURRENT=3
# Leave blank to run yt-dlp as `python -m yt_dlp`; set to a binary path to override.
YT_DLP_PATH=

# Cloud upload of recordings (/record_upload) via rclone — for files too large
# for a direct Discord upload. Leave RCLONE_REMOTE blank to disable.
#   1. Create an rclone remote once on the host: `rclone config` (e.g. a Google
#      Drive remote named "gdrive").
#   2. Mount that rclone.conf into the container (see docker-compose) and point
#      RCLONE_CONFIG at it.
#   3. Set RCLONE_REMOTE to "<remote>:<folder>", e.g. gdrive:vtuber-recordings.
# rclone (not rsync) is used because it uploads to Google Drive et al. and can
# return a shareable link, which the bot posts to the channel.
RCLONE_REMOTE=
RCLONE_CONFIG=
# Override the rclone binary if it isn't on PATH.
RCLONE_PATH=rclone